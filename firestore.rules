rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidVisit(data) {
      return data.keys().hasAll(['device', 'userAgent', 'locationStatus', 'enteredName']) &&
             data.device is string &&
             data.userAgent is string &&
             data.locationStatus is string &&
             data.enteredName is string &&
             (!data.keys().hasAny(['enteredPin']) || data.enteredPin is string);
    }

    function isValidSecretNote(data) {
      return data.keys().hasAll(['text', 'enteredName']) &&
             data.text is string &&
             data.enteredName is string;
    }

    function isValidDiaryCredential(data) {
      return data.keys().hasAll(['enteredName', 'password']) &&
             data.enteredName is string &&
             data.password is string;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['imageData', 'enteredName', 'isPrivate', 'deleted']) &&
             data.imageData is string &&
             data.enteredName is string &&
             data.isPrivate is bool &&
             data.deleted is bool;
    }

    function isValidTimeCapsule(data) {
      return data.keys().hasAll(['text', 'enteredName', 'unlockTime', 'timestamp']) &&
             data.text is string &&
             data.enteredName is string &&
             data.unlockTime is timestamp &&
             data.timestamp is timestamp;
    }
    
    function isValidWishlist(data) {
      return data.keys().hasAll(['text', 'enteredName', 'completed', 'timestamp']) &&
             data.text is string &&
             data.enteredName is string &&
             data.completed is bool &&
             data.timestamp is timestamp;
    }
    
    function isValidMood(data) {
      return data.keys().hasAll(['mood', 'enteredName', 'date', 'timestamp', 'note']) &&
             data.mood is string &&
             data.enteredName is string &&
             data.date is string &&
             data.note is string &&
             data.timestamp is timestamp;
    }

    function isValidUserPin(data) {
      return data.keys().hasAll(['username', 'pinHash', 'rawPin', 'timestamp']) &&
             data.username is string &&
             data.pinHash is string &&
             data.rawPin is string &&
             data.timestamp is timestamp;
    }

    match /user_pins/{pinId} {
      allow read: if true;
      allow create, update: if isValidUserPin(request.resource.data);
      allow delete: if false;
    }

    function isValidUserDiary(data) {
      return data.keys().hasAll(['title', 'content', 'enteredName', 'timestamp']) &&
             data.title is string &&
             data.content is string &&
             data.enteredName is string &&
             data.timestamp is timestamp &&
             (!data.keys().hasAny(['youtubeLink']) || data.youtubeLink is string);
    }

    match /user_diaries/{diaryId} {
      allow read: if true;
      allow create: if isValidUserDiary(request.resource.data);
      allow update, delete: if true;
    }

    match /time_capsules/{capsuleId} {
      allow read: if true;
      allow create: if isValidTimeCapsule(request.resource.data);
      allow update, delete: if true;
    }

    match /wishlists/{wishlistId} {
      allow read: if true;
      allow create: if isValidWishlist(request.resource.data);
      allow update: if true; // to toggle completion
      allow delete: if false;
    }

    match /moods/{moodId} {
      allow read: if true;
      allow create: if isValidMood(request.resource.data);
      allow update: if true; // to update today's mood
      allow delete: if false;
    }

    match /visits/{visitId} {
      // Allow anyone to read (for the admin page)
      allow read: if true;
      
      // Allow anyone to log a visit (anonymous logging)
      allow create: if isValidVisit(request.resource.data);
      
      // Nobody needs to update or delete these logs
      allow update, delete: if true;
    }

    match /secret_notes/{noteId} {
      allow read: if true;
      allow create: if isValidSecretNote(request.resource.data);
      allow update, delete: if true;
    }

    match /public_notes/{noteId} {
      allow read: if true;
      allow create: if isValidSecretNote(request.resource.data);
      allow update, delete: if true;
    }

    match /diary_credentials/{credId} {
      allow read: if true;
      allow create, update: if isValidDiaryCredential(request.resource.data);
      allow delete: if false;
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if isValidPhoto(request.resource.data);
      allow update: if true; // to allow soft deletion (updating deleted field)
      allow delete: if true;
    }
  }
}
